{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "apps/api/Dockerfile",
    "watchPatterns": [
      "apps/api/**",
      "packages/contracts/**",
      "package.json",
      "pnpm-lock.yaml",
      "pnpm-workspace.yaml",
      "railway.control-plane.json",
      "tsconfig.base.json",
      "turbo.json"
    ]
  },
  "deploy": {
    "drainingSeconds": 15,
    "healthcheckPath": "/health/ready",
    "healthcheckTimeout": 120,
    "overlapSeconds": 30,
    "restartPolicyMaxRetries": 10,
    "restartPolicyType": "ON_FAILURE"
  }
}
