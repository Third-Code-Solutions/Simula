# Local-only bootstrap values. Copy to .env and replace placeholders locally.
SIMULA_ENVIRONMENT=local
# Required: exact lowercase output from `git rev-parse HEAD`.
SIMULA_RELEASE_SHA=replace-with-exact-40-character-git-sha
# Deployed runtimes must bind to the compiled schema head. Production also
# requires the verified Sigstore bundle digest and its exact GitHub Actions run.
SIMULA_DATABASE_MIGRATION_HEAD=20260802143000
SIMULA_PRODUCTION_ADMISSION_ENABLED=false
SIMULA_PRODUCTION_ROLLOUT_ID=replace-with-lowercase-uuidv4
SIMULA_RELEASE_BUNDLE_SHA256=replace-with-exact-lowercase-release-bundle-sha256
SIMULA_RELEASE_SIGSTORE_BUNDLE_SHA256=replace-with-exact-lowercase-sigstore-bundle-sha256
SIMULA_RELEASE_PROVENANCE_URL=https://github.com/Third-Code-Solutions/Simula/actions/runs/replace-with-run-id
# Server-owned result UI rollback: set false to retain data/API but hide presentation.
SIMULA_RESULT_EXPERIENCE_ENABLED=true
# Server-owned experimental behavioral UI admission. Requires domain API v2.
SIMULA_BEHAVIORAL_DEMO_ENABLED=false
# Server-owned private asset UI admission. Requires domain API v2 and API storage.
SIMULA_PRIVATE_ASSET_WORKFLOW_ENABLED=false
# Server-owned technical image-profile admission. Requires private assets and v2.
SIMULA_TECHNICAL_VISUAL_PROFILE_ENABLED=false
SIMULA_LOG_LEVEL=INFO
# Optional vendor export. Disabled until both privacy-bounded exporters are configured.
SIMULA_TELEMETRY_ENABLED=false
SIMULA_TELEMETRY_TRACES_SAMPLE_RATE=0.1
SIMULA_SENTRY_DSN=https://replace-with-sentry-public-key@replace-with-sentry-host/replace-with-project
SIMULA_OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://replace-with-collector/v1/traces
SIMULA_REDIS_URL=redis://127.0.0.1:6379/0
# Integration tests ignore runtime Redis configuration and use fixed loopback DB 15.
SIMULA_DATABASE_URL=postgresql://simula_api:replace-locally@127.0.0.1:54322/postgres?sslmode=disable
# Railway worker uses a separate least-privilege role and secret.
SIMULA_WORKER_DATABASE_URL=postgresql://simula_worker:replace-locally@127.0.0.1:54322/postgres?sslmode=disable
SIMULA_WORKER_METRICS_PORT=9464
# Rollback-safe default. Use bullmq only with the separate NestJS dispatcher.
SIMULA_WORKER_QUEUE_TRANSPORT=arq
# Private engine auth rotation set. Use one or two locally generated tokens; never commit them.
SIMULA_AI_ENGINE_INTERNAL_TOKENS=["replace-with-a-local-32-byte-minimum-token"]
# Disabled rollback default. private_http requires BullMQ and production release admission.
SIMULA_BEHAVIORAL_ENGINE_TRANSPORT=disabled
SIMULA_BEHAVIORAL_ENGINE_URL=http://127.0.0.1:8010
SIMULA_BEHAVIORAL_ENGINE_TOKEN=replace-with-the-same-local-engine-token
# Private stimulus bytes. Keep disabled until server-only Supabase S3 keys exist.
SIMULA_ASSET_STORAGE_ENABLED=false
SIMULA_ASSET_STORAGE_ENDPOINT=http://127.0.0.1:54321/storage/v1/s3
SIMULA_ASSET_STORAGE_REGION=local
SIMULA_ASSET_STORAGE_ACCESS_KEY_ID=replace-with-local-s3-access-key
SIMULA_ASSET_STORAGE_SECRET_ACCESS_KEY=replace-with-local-s3-secret-key
# Operator-only recovery CLI; provision this role password outside Git.
SIMULA_OPERATOR_DATABASE_URL=postgresql://simula_operator:replace-locally@127.0.0.1:54322/postgres?sslmode=disable
SIMULA_SUPABASE_URL=http://127.0.0.1:54321
SIMULA_SUPABASE_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json
SIMULA_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_local_value
SIMULA_CURSOR_SECRET=replace-with-a-local-32-byte-minimum-secret
SIMULA_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# Railway injects PORT for the public API. Local default is 8000.
PORT=8000
NEXT_PUBLIC_SIMULA_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_SIMULA_DOMAIN_API_VERSION=v1
NEXT_PUBLIC_SIMULA_TELEMETRY_ENABLED=false
NEXT_PUBLIC_SIMULA_ENVIRONMENT=local
NEXT_PUBLIC_SIMULA_RELEASE_SHA=replace-with-exact-40-character-git-sha
NEXT_PUBLIC_SENTRY_DSN=https://replace-with-sentry-public-key@replace-with-sentry-host/replace-with-project
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
