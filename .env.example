# Local-only bootstrap values. Copy to .env and replace placeholders locally.
SIMULA_ENVIRONMENT=local
SIMULA_RELEASE_SHA=dev
SIMULA_LOG_LEVEL=INFO
SIMULA_REDIS_URL=redis://127.0.0.1:6379/0
# Integration tests ignore runtime Redis configuration and use fixed loopback DB 15.
SIMULA_DATABASE_URL=postgresql://simula_api:replace-locally@127.0.0.1:54322/postgres?sslmode=disable
SIMULA_SUPABASE_URL=http://127.0.0.1:54321
SIMULA_SUPABASE_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json
SIMULA_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_local_value
SIMULA_CURSOR_SECRET=replace-with-a-local-32-byte-minimum-secret
SIMULA_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
NEXT_PUBLIC_SIMULA_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
