{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "apps/web/Dockerfile",
    "watchPatterns": [
      "apps/web/**",
      "packages/contracts/**",
      "package.json",
      "pnpm-lock.yaml",
      "pnpm-workspace.yaml",
      "railway.web.json",
      "tsconfig.base.json",
      "turbo.json"
    ]
  },
  "deploy": {
    "drainingSeconds": 15,
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 120,
    "overlapSeconds": 30,
    "startCommand": null,
    "restartPolicyMaxRetries": 10,
    "restartPolicyType": "ON_FAILURE"
  },
  "environments": {
    "production": {
      "build": {
        "buildEnvironment": "V2"
      }
    }
  }
}
