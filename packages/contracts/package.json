{
  "name": "@simula/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./behavioral-comparison.schema.json": "./behavioral-comparison.schema.json",
    "./behavioral-evaluation-report.schema.json": "./behavioral-evaluation-report.schema.json",
    "./behavioral-report.schema.json": "./behavioral-report.schema.json",
    "./context-graph.schema.json": "./context-graph.schema.json",
    "./result.schema.json": "./result.schema.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "generate": "openapi-typescript openapi.json -o src/openapi.ts --alphabetize && openapi-typescript ../../apps/api/openapi.json -o src/control-plane.ts --alphabetize",
    "lint": "tsc --noEmit",
    "test": "node --test tests/contracts.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
