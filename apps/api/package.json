{
  "name": "@simula/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "lint": "tsc -p tsconfig.json --noEmit",
    "openapi:check": "node dist/openapi/export-openapi.js --check",
    "openapi:generate": "node dist/openapi/export-openapi.js --write",
    "start": "node --require ./dist/instrumentation.js dist/main.js",
    "start:dispatcher": "node --require ./dist/instrumentation.js dist/dispatcher/main.js",
    "test": "jest --runInBand",
    "test:database-integration": "jest --config jest.database.config.cjs --runInBand",
    "test:integration": "jest --config jest.integration.config.cjs --runInBand",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1097.0",
    "@nestjs/bullmq": "11.0.4",
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/swagger": "11.4.6",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/auto-instrumentations-node": "0.79.0",
    "@opentelemetry/core": "2.10.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.221.0",
    "@opentelemetry/resources": "2.10.0",
    "@opentelemetry/sdk-node": "0.221.0",
    "@opentelemetry/sdk-trace-base": "2.10.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "@sentry/node": "10.69.0",
    "@simula/contracts": "workspace:*",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "bullmq": "5.81.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "express": "5.2.1",
    "ioredis": "5.11.1",
    "jsonwebtoken": "9.0.3",
    "pg": "8.22.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "24.13.3",
    "@types/pg": "8.20.0",
    "@types/supertest": "7.2.1",
    "jest": "30.4.2",
    "supertest": "7.2.2",
    "ts-jest": "29.4.12",
    "tsx": "4.23.1",
    "typescript": "5.9.3"
  },
  "jest": {
    "collectCoverageFrom": [
      "**/*.(t|j)s",
      "!**/*.d.ts",
      "!main.ts",
      "!openapi/**"
    ],
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testEnvironment": "node",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "tsconfig": "<rootDir>/../tsconfig.spec.json"
        }
      ]
    }
  }
}
